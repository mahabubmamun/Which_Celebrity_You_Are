import os
import pickle
import numpy as np
import cv2

from tqdm import tqdm
from mtcnn import MTCNN
from keras_facenet import FaceNet


# =========================================================
# 1. Load FaceNet
# =========================================================

embedder = FaceNet()

# MTCNN face detector
detector = MTCNN()


# =========================================================
# 2. Get all image paths
# =========================================================

actors = os.listdir("data")

filenames = []

for actor in actors:

    actor_path = os.path.join("data", actor)

    # Make sure it is a folder
    if not os.path.isdir(actor_path):
        continue

    for file in os.listdir(actor_path):

        file_path = os.path.join(actor_path, file)

        # Only image files
        if file.lower().endswith(
            (".jpg", ".jpeg", ".png", ".webp")
        ):
            filenames.append(file_path)


print("Total images:", len(filenames))


# =========================================================
# 3. Extract face
# =========================================================

def extract_face(img_path):

    # Open image using OpenCV
    img = cv2.imread(img_path)

    if img is None:
        print("Could not read:", img_path)
        return None

    # BGR → RGB
    img_rgb = cv2.cvtColor(
        img,
        cv2.COLOR_BGR2RGB
    )

    # Detect faces
    results = detector.detect_faces(img_rgb)

    if len(results) == 0:
        print("No face detected:", img_path)
        return None

    # -----------------------------------------------------
    # If multiple faces exist, choose the largest face
    # -----------------------------------------------------

    best_face = max(
        results,
        key=lambda x: x["box"][2] * x["box"][3]
    )

    x, y, width, height = best_face["box"]

    # Prevent negative coordinates
    x = max(0, x)
    y = max(0, y)

    # Prevent coordinates going outside image
    x2 = min(
        img_rgb.shape[1],
        x + width
    )

    y2 = min(
        img_rgb.shape[0],
        y + height
    )

    face = img_rgb[
        y:y2,
        x:x2
    ]

    if face.size == 0:
        return None

    # FaceNet expects 160 × 160
    face = cv2.resize(
        face,
        (160, 160)
    )

    return face


# =========================================================
# 4. Feature extraction
# =========================================================

features = []

valid_filenames = []


for file in tqdm(
    filenames,
    desc="Extracting FaceNet embeddings"
):

    face = extract_face(file)

    if face is None:
        continue

    # FaceNet embedding
    embedding = embedder.embeddings(
        np.expand_dims(face, axis=0)
    )[0]

    # -----------------------------------------------------
    # L2 normalization
    # -----------------------------------------------------

    embedding = embedding / np.linalg.norm(
        embedding
    )

    features.append(embedding)

    valid_filenames.append(file)


# =========================================================
# 5. Convert to numpy
# =========================================================

features = np.array(features)


print()
print("Successfully processed:", len(features))
print("Skipped:", len(filenames) - len(features))
print("Embedding shape:", features.shape)


# =========================================================
# 6. Save embeddings
# =========================================================

pickle.dump(
    features,
    open("embedding.pkl", "wb")
)

pickle.dump(
    valid_filenames,
    open("filenames.pkl", "wb")
)


print()
print("embedding.pkl saved")
print("filenames.pkl saved")